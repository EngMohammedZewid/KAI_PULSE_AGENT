# KAI Pulse on LangGraph. Copy to .env and fill in. NEVER commit .env.

# ---- Database (docker compose builds DATABASE_URL from this) ----
POSTGRES_PASSWORD=
# Outside docker compose, set the full URL instead:
# DATABASE_URL=postgresql://kai:<password>@localhost:5432/kai

# ---- Chat model ----
KAI_MODEL_PROVIDER=watsonx          # watsonx | openai | anthropic | dev (no LLM, echo only)
KAI_MODEL_ID=openai/gpt-oss-120b
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=
WATSONX_API_KEY=
# For KAI_MODEL_PROVIDER=openai:
# KAI_MODEL_BASE_URL=
# OPENAI_API_KEY=
# For KAI_MODEL_PROVIDER=anthropic (e.g. Qwen on Alibaba Cloud Model Studio):
# KAI_MODEL_ID=qwen4-max
# KAI_MODEL_BASE_URL=https://<workspace>.<region>.maas.aliyuncs.com/apps/anthropic
# DASHSCOPE_API_KEY=                # or ANTHROPIC_API_KEY

# ---- Uploaded files ----
KAI_FILE_STORE=local                # local (volume /data/files) | s3
KAI_MAX_UPLOAD_MB=20

# ---- S3 (uploads when KAI_FILE_STORE=s3, and generated reports/exports) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=                      # required for reports/exports; there is no default bucket
AWS_S3_REGION=us-east-2

# ---- Links the server may download (report images, email attachments) ----
# QuickChart, AWS S3 and IBM COS are always allowed; add more hosts, comma-separated.
# KAI_FETCH_ALLOWED_HOSTS=

# ---- IBM Cloud Object Storage (COS chart tools) ----
COS_API_KEY=
COS_BUCKET=
COS_ENDPOINT=

# ---- Cognos Analytics (set one auth method) ----
COGNOS_BASE_URL=
COGNOS_BEARER_TOKEN=
# COGNOS_API_KEY=
# COGNOS_API_KEY_HEADER=X-API-Key
# COGNOS_CAM_PASSPORT=

# ---- Email (send_file_via_sendgrid) ----
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=KAI Pulse Agent

# ---- PDF statements via LLM extraction (analyze_bank_statement) ----
DEEPSEEK_API_KEY=

# ---- Tracing (LangSmith; leave off to keep traces local) ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kai-pulse
