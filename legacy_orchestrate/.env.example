# ============================================================
# watsonx Orchestrate – Payload Extractor Configuration
# Copy to .env and fill in your values. NEVER commit .env to git.
# ============================================================

# ---- watsonx Orchestrate connection ----------------------------
# SaaS: set WXO_API_KEY (IBM Cloud IAM key)
WXO_API_KEY=

# Developer Edition: use username + password instead
# WXO_USERNAME=admin
# WXO_PASSWORD=

# API endpoint (no trailing slash)
# SaaS example:   https://api.us-south.watson-orchestrate.cloud.ibm.com
# Dev Edition:    http://localhost:4321
WXO_API_ENDPOINT=

# Agent UUID to filter (optional – leave blank to capture all agents)
WXO_AGENT_ID=

# ---- Database (SQL targets) ------------------------------------
DB_TYPE=postgresql        # postgresql | mysql | sqlite | mongodb

DB_HOST=localhost
DB_PORT=5432
DB_USER=wxo_user
DB_PASSWORD=change_me
DB_NAME=wxo_payloads

# SQLite (local dev only)
# DB_TYPE=sqlite
# DB_SQLITE_PATH=agent_payloads.db

# ---- MongoDB ---------------------------------------------------
# DB_TYPE=mongodb
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=wxo_payloads

# ---- SMTP email delivery ---------------------------------------
# Used by create_pdf_report / create_word_report when email_to is provided.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=watsonx Orchestrate
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=30

# ---- SendGrid email delivery (standalone file-email tool) -----
# Used by tool: send_file_via_sendgrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=watsonx Orchestrate
